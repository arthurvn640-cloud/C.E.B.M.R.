<script>

/* =========================================================
   SISTEMA DOS 4 CÓDIGOS
========================================================= */

const paginas = {

    "1":"historia.html",
    "historia":"historia.html",
    "história":"historia.html",

    "2":"obscuro.html",
    "vnb4":"obscuro.html",

    "3":"serra-moveis.html",
    "serra moveis":"serra-moveis.html",
    "serra móveis":"serra-moveis.html",
    "serramoveis":"serra-moveis.html",

    "4":"index.html",
    "cebmr":"index.html",
    "c.e.b.m.r.":"index.html"

};


function pesquisarCodigo(){

    const entrada=document
        .getElementById("codigo-input")
        .value
        .trim()
        .toLowerCase();

    const resultado=document
        .getElementById("resultado-codigo");


    if(paginas[entrada]){

        resultado.className=
            "resultado-sucesso";

        resultado.textContent=
            "Código encontrado! Abrindo...";


        setTimeout(function(){

            window.location.href=
                paginas[entrada];

        },300);


    }else{

        resultado.className=
            "resultado-erro";

        resultado.textContent=
            "Código não encontrado.";

    }

}


document
    .getElementById("pesquisar-btn")
    .addEventListener(
        "click",
        pesquisarCodigo
    );


document
    .getElementById("codigo-input")
    .addEventListener(
        "keydown",
        function(event){

            if(event.key==="Enter"){

                pesquisarCodigo();

            }

        }
    );


/* =========================================================
   CHAT LOCAL
========================================================= */

const nomeInput=
    document.getElementById("nome");

const mensagemInput=
    document.getElementById("message-input");

const enviarBtn=
    document.getElementById("send-btn");

const chatBox=
    document.getElementById("chat-box");


function enviarMensagem(){

    const nome=
        nomeInput.value.trim();

    const mensagem=
        mensagemInput.value.trim();


    if(!nome){

        alert("Digite seu nome primeiro.");

        nomeInput.focus();

        return;
    }


    if(!mensagem){

        mensagemInput.focus();

        return;
    }


    const bloco=
        document.createElement("div");

    bloco.className=
        "mensagem";


    const nomeElemento=
        document.createElement("div");

    nomeElemento.className=
        "mensagem-nome";

    nomeElemento.textContent=
        nome;


    const textoElemento=
        document.createElement("div");

    textoElemento.className=
        "mensagem-texto";

    textoElemento.textContent=
        mensagem;


    const horaElemento=
        document.createElement("div");

    horaElemento.className=
        "mensagem-hora";


    const agora=
        new Date();


    horaElemento.textContent=
        agora.toLocaleTimeString(
            "pt-BR",
            {
                hour:"2-digit",
                minute:"2-digit"
            }
        );


    bloco.appendChild(
        nomeElemento
    );

    bloco.appendChild(
        textoElemento
    );

    bloco.appendChild(
        horaElemento
    );


    chatBox.appendChild(
        bloco
    );


    chatBox.scrollTop=
        chatBox.scrollHeight;


    mensagemInput.value="";

    mensagemInput.focus();
}


enviarBtn.addEventListener(
    "click",
    enviarMensagem
);


mensagemInput.addEventListener(
    "keydown",
    function(event){

        if(event.key==="Enter"){

            enviarMensagem();

        }

    }
);

</script>

