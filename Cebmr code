<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>C.E.B.M.R.</title>

<style>

*{
    box-sizing:border-box;
}

html,
body{
    margin:0;
    padding:0;
    width:100%;
    min-height:100%;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#eeeeee;
    padding:10px;
}

.site{
    width:100%;
    max-width:1100px;
    margin:0 auto;
    background:#ffffff;
    border-radius:18px;
    padding:15px;
}


/* PRINCIPAL */

.principal{
    width:100%;
    min-height:260px;

    background:#f7fafc;

    border:2px solid #dddddd;

    border-radius:15px;

    padding:25px 20px;

    text-align:center;
}

.nome-site{
    display:block;
    width:100%;

    margin:0 0 18px 0;

    color:#111111;

    font-size:clamp(28px,4vw,40px);

    font-weight:bold;

    line-height:1.3;

    text-align:center;

    overflow-wrap:break-word;
}

.descricao{
    display:block;
    width:100%;

    margin:0 auto 25px auto;

    color:#333333;

    font-size:clamp(15px,2vw,18px);

    line-height:1.6;

    text-align:center;

    overflow-wrap:break-word;
}


/* BOTÕES */

.botoes{
    width:100%;
    text-align:center;
}

.botao{
    display:flex;

    width:100%;
    max-width:320px;
    height:60px;

    margin:0 auto 12px auto;

    align-items:center;
    justify-content:center;

    color:#ffffff;

    text-decoration:none;

    border-radius:10px;

    font-size:18px;

    font-weight:bold;

    transition:.2s;
}

.youtube{
    background:#ff0000;
}

.youtube:hover{
    background:#d90000;
}

.tiktok{
    background:#111111;
}

.tiktok:hover{
    background:#333333;
}


/* PESQUISA */

.pesquisa-codigo{
    width:100%;

    margin-top:25px;

    background:#ffffff;

    border:2px solid #dddddd;

    border-radius:15px;

    padding:20px;
}

.pesquisa-codigo h2{
    margin:0 0 8px;

    color:#111111;

    text-align:center;

    font-size:25px;
}

.pesquisa-codigo p{
    margin:0 0 18px;

    color:#666666;

    text-align:center;

    font-size:14px;
}

.barra-pesquisa{
    display:flex;

    width:100%;

    gap:10px;
}

#codigo-input{
    flex:1;

    min-width:0;

    height:50px;

    padding:0 15px;

    border:2px solid #cccccc;

    border-radius:10px;

    outline:none;

    font-size:16px;
}

#codigo-input:focus{
    border-color:#2563eb;
}

#pesquisar-btn{
    height:50px;

    padding:0 22px;

    border:none;

    border-radius:10px;

    background:#2563eb;

    color:#ffffff;

    font-size:16px;

    font-weight:bold;

    cursor:pointer;
}

#pesquisar-btn:hover{
    background:#1d4ed8;
}

#resultado-codigo{
    display:none;

    margin-top:15px;

    padding:12px;

    border-radius:9px;

    text-align:center;

    font-size:14px;

    font-weight:bold;
}

.resultado-sucesso{
    display:block!important;

    background:#e7f8ed;

    color:#218838;
}

.resultado-erro{
    display:block!important;

    background:#ffe8e8;

    color:#c62828;
}


/* INSTRUÇÕES */

.titulo-instrucoes{
    width:100%;

    color:#111111;

    font-size:clamp(23px,3vw,28px);

    text-align:center;

    margin:30px 0 20px;
}

.coluna{
    width:100%;

    background:#f7fafc;

    border:2px solid #dddddd;

    border-radius:15px;

    padding:15px;

    overflow:hidden;
}

.titulo-coluna{
    text-align:center;

    color:#333333;

    font-size:23px;

    margin:0 0 20px;
}

.instrucoes{
    width:100%;

    display:grid;

    grid-template-columns:
    repeat(4,minmax(0,1fr));

    gap:12px;
}

.passo{
    width:100%;

    min-width:0;

    background:#ffffff;

    border:2px solid #dddddd;

    border-radius:10px;

    padding:15px;

    min-height:150px;

    overflow-wrap:anywhere;
}

.numero{
    display:block;

    color:#2563eb;

    font-size:20px;

    font-weight:bold;

    margin-bottom:10px;
}

.texto{
    color:#444444;

    font-size:16px;

    line-height:1.5;

    overflow-wrap:anywhere;

    word-break:break-word;
}


/* CHAT */

.chat{
    width:100%;

    margin-top:25px;

    background:#f7fafc;

    border:2px solid #dddddd;

    border-radius:15px;

    overflow:hidden;
}

.chat-header{
    padding:20px;

    background:#ffffff;

    border-bottom:1px solid #dddddd;
}

.chat-header h2{
    margin:0;

    color:#111111;

    font-size:28px;

    text-align:center;
}

.chat-subtitulo{
    margin:8px 0 0;

    color:#666666;

    text-align:center;

    font-size:14px;
}

.nome-area{
    padding:15px;

    background:#fafafa;

    border-bottom:1px solid #eeeeee;
}

.nome-area label{
    display:block;

    color:#333333;

    font-size:14px;

    font-weight:bold;

    margin-bottom:7px;
}

#nome{
    width:100%;

    height:45px;

    padding:0 13px;

    border:1px solid #cccccc;

    border-radius:8px;

    outline:none;

    font-size:15px;
}

#chat-box{
    width:100%;

    height:430px;

    overflow-y:auto;

    padding:18px;

    background:#ffffff;
}

.mensagem{
    width:fit-content;

    max-width:85%;

    background:#f1f1f1;

    padding:11px 14px;

    border-radius:10px;

    margin-bottom:13px;

    word-break:break-word;
}

.mensagem-nome{
    color:#1565c0;

    font-weight:bold;

    font-size:14px;

    margin-bottom:5px;
}

.mensagem-texto{
    color:#222222;

    font-size:15px;

    line-height:1.45;
}

.mensagem-hora{
    color:#888888;

    font-size:11px;

    margin-top:5px;
}

.envio{
    display:flex;

    gap:10px;

    padding:15px;

    background:#ffffff;

    border-top:1px solid #dddddd;
}

#message-input{
    flex:1;

    min-width:0;

    height:46px;

    padding:0 14px;

    border:1px solid #cccccc;

    border-radius:8px;

    outline:none;

    font-size:15px;
}

#send-btn{
    height:46px;

    padding:0 25px;

    border:none;

    border-radius:8px;

    background:#1976d2;

    color:#ffffff;

    font-weight:bold;

    font-size:15px;

    cursor:pointer;
}

#status{
    text-align:center;

    padding:9px;

    border-top:1px solid #eeeeee;

    background:#ffffff;

    color:#777777;

    font-size:13px;
}


/* CELULAR */

@media screen and (max-width:600px){

    body{
        padding:5px;
    }

    .site{
        padding:5px;
    }

    .principal{
        min-height:0;
        padding:25px 10px;
    }

    .botao{
        max-width:none;
    }

    .barra-pesquisa{
        flex-direction:column;
    }

    #codigo-input{
        width:100%;
    }

    #pesquisar-btn{
        width:100%;
    }

    .instrucoes{
        grid-template-columns:1fr;
    }

    #chat-box{
        height:60vh;
        min-height:350px;
    }

    .envio{
        gap:7px;
    }

    #send-btn{
        padding:0 17px;
    }
}

</style>

</head>

